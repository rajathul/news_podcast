# Copy this file to .env and fill in your values.

# Required: Google Gemini API key
# Used for: transcript generation (Gemini 2.5 Flash) and TTS synthesis(Gemini 2.5 Flash TTS)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Supabase project credentials
# Create a free project at https://supabase.com, then go to Project Settings → API
# Create a public bucket called "podcasts" under Storage
# Use the service_role key (not anon) — uploads happen server-side only, never exposed to browser
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_service_role_key_here

# Optional: Set to 1 to skip TTS synthesis (transcript still generated if GEMINI_API_KEY is set)
# Useful during development to avoid TTS costs
# Default: unset (TTS enabled)
PODCAST_FAKE_AUDIO=1
